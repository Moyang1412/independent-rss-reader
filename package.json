{
  "name": "independent-rss-reader",
  "version": "0.1.2",
  "private": true,
  "license": "MIT",
  "description": "Independent local and personal RSS reader for Obsidian.",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "dompurify": "^3.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "jsdom": "^26.0.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
